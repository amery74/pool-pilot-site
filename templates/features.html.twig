{% block content %}
<section class="features-page-hero">
  <div class="features-page-hero-inner">
    <span class="eyebrow">FONCTIONNALITÉS</span>
    <h1>Tout Pool Pilot,<br><span>fonction par fonction.</span></h1>
    <p>
      Découvrez les outils disponibles pour surveiller l’eau, automatiser la filtration,
      piloter les équipements et simplifier l’entretien de votre piscine.
    </p>
  </div>
</section>

<nav class="features-page-nav" aria-label="Sommaire des fonctionnalités">
  <a href="#qualite-eau">Qualité de l’eau</a>
  <a href="#filtration">Filtration</a>
  <a href="#pac">Pompe à chaleur</a>
  <a href="#electrolyseur">Électrolyseur</a>
  <a href="#maintenance">Maintenance</a>
  <a href="#entretien">Entretien</a>
  <a href="#produits">Produits</a>
  <a href="#meteo">Météo</a>
  <a href="#historique">Historique</a>
  <a href="#notifications">Notifications</a>
  <a href="#dashboard">Dashboard</a>
  <a href="#avance">Mode expert</a>
</nav>

