{% for section in sections %}
<section class="features-detail{% if loop.index is even %} features-detail-alt{% endif %}" id="{{ section.id }}">
  <div class="features-detail-copy">
    <span class="features-kicker">{{ section.number }} · {{ section.title|upper }}</span>
    <h2>{{ section.heading }}</h2>
    <p>{{ section.text }}</p>
    <ul>
      {% for item in section.items %}
      <li>{{ item }}</li>
      {% endfor %}
    </ul>
  </div>

  <aside class="features-benefit">
    {% if section.id == 'dashboard' %}
    <img src="{{ url('theme://images/pool-pilot-dashboard.png') }}" alt="Pool Pilot Dashboard">
    {% else %}
    <strong>Le bénéfice</strong>
    <p>{{ section.benefit }}</p>
    {% endif %}
  </aside>
</section>
{% endfor %}

<section class="features-page-cta">
  <div>
    <h2>Prêt à installer Pool Pilot ?</h2>
    <p>Consultez le guide d’installation via HACS.</p>
  </div>
  <a class="button button-light" href="{{ base_url_absolute }}/installation">Voir l’installation</a>
</section>
{% endblock %}
