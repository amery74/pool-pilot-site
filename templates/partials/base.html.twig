{% set lang = grav.language.getActive ?: 'fr' %}
<!doctype html>
<html lang="{{ lang }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="{{ page.header.metadata.description|default('Pool Pilot, intégration HACS pour piloter intelligemment votre piscine depuis Home Assistant.') }}">
  <meta property="og:title" content="{{ page.title|default('Pool Pilot') }}">
  <meta property="og:description" content="Votre piscine, parfaitement pilotée depuis Home Assistant.">
  <meta property="og:image" content="{{ url('theme://images/social-preview.png', true) }}">
  <title>{% if page.title %}{{ page.title }} · {% endif %}Pool Pilot</title>

  <link rel="icon" href="{{ url('theme://images/favicon.svg') }}" type="image/svg+xml">
  <link rel="icon" href="{{ url('theme://images/favicon-32.png') }}" sizes="32x32">
  <link rel="apple-touch-icon" href="{{ url('theme://images/apple-touch-icon.png') }}">

  {% do assets.addCss('theme://css/site.css?v=034', 100) %}
  {% do assets.addCss('theme://css/features.css?v=034', 90) %}
  {% do assets.addCss('theme://css/installation.css?v=040', 80) %}
  {% do assets.addCss('theme://css/home-v041.css?v=041', 70) %}
  {% do assets.addJs('theme://js/site.js?v=034', 100) %}
  {{ assets.css()|raw }}
</head>
<body>
  {% include 'partials/header.html.twig' %}
  <main>
    {% block content %}{% endblock %}
  </main>
  {% include 'partials/footer.html.twig' %}
  {{ assets.js()|raw }}
</body>
</html>
