{% extends 'partials/base.html.twig' %}

{% block content %}
<section class="hero" id="accueil">
  <div class="hero-copy">
    <span class="eyebrow">INTÉGRATION HOME ASSISTANT VIA HACS</span>
    <h1>Votre piscine,<br><span>parfaitement pilotée.</span></h1>
    <p>
      Pool Pilot centralise le suivi de l’eau, la filtration, le chauffage,
      les équipements, l’entretien et les alertes directement dans Home Assistant.
    </p>

    <ul class="hero-list">
      <li>Installation et mises à jour via HACS</li>
      <li>Automatisations avancées</li>
      <li>Historique sur 24 h, 7 jours et 30 jours</li>
      <li>Notifications et recommandations</li>
    </ul>

    <div class="hero-actions">
      <a class="button button-light" href="#installation">Installer via HACS</a>
      <a class="button button-outline" href="#fonctionnalites">Découvrir les fonctionnalités</a>
    </div>

    <small>Open source · Données locales · Projet communautaire</small>
  </div>

  <div class="ha-window" aria-label="Aperçu de Pool Pilot dans Home Assistant">
    <div class="ha-topbar">
      <span aria-hidden="true">☰</span>
      <strong>Home Assistant</strong>
      <span class="ha-top-icons" aria-hidden="true">⌂　◉　▦　⚡　⋯</span>
    </div>

    <div class="ha-layout">
      <aside class="ha-sidebar" aria-label="Menu Home Assistant">
        <strong>Aperçu</strong>
        <span>Énergie</span>
        <span>Carte</span>
        <span>Journal</span>
        <span>Historique</span>
        <span>Médias</span>
        <span>Listes de tâches</span>
        <i></i>
        <span>Paramètres</span>
        <span>Notifications</span>
      </aside>

      <section class="ha-content">
        <div class="ha-content-title">
          <h2>Piscine</h2>
          <span>Home Assistant</span>
        </div>
        <div class="dashboard-frame">
          <img
            src="{{ url('theme://images/pool-pilot-dashboard.png') }}"
            alt="Vraie carte Pool Pilot Dashboard dans Home Assistant">
        </div>
      </section>
    </div>
  </div>
</section>

<section class="section section-features" id="fonctionnalites">
  <header class="section-heading">
    <span>FONCTIONNALITÉS</span>
    <h2>Une seule interface pour comprendre et piloter votre bassin</h2>
    <p>
      Pool Pilot regroupe les informations importantes et les commandes de votre piscine
      sans ajouter de tableau de bord artificiel en dehors de Home Assistant.
    </p>
  </header>

  <div class="feature-grid">
    <article>
      <div class="feature-icon" aria-hidden="true">💧</div>
      <h3>Analyse de l’eau</h3>
      <p>pH, ORP ou chlore libre, température, seuils, alertes et recommandations.</p>
    </article>
    <article>
      <div class="feature-icon" aria-hidden="true">⚙️</div>
      <h3>Automatisation avancée</h3>
      <p>Filtration, PAC et électrolyseur pilotés selon vos paramètres et conditions réelles.</p>
    </article>
    <article>
      <div class="feature-icon" aria-hidden="true">🔔</div>
      <h3>Alertes intelligentes</h3>
      <p>Notifications et recommandations lorsqu’une action ou une correction est nécessaire.</p>
    </article>
    <article>
      <div class="feature-icon" aria-hidden="true">📊</div>
      <h3>Historique</h3>
      <p>Consultez les mesures et tendances sur 24 heures, 7 jours et 30 jours.</p>
    </article>
    <article>
      <div class="feature-icon" aria-hidden="true">🧰</div>
      <h3>Entretien</h3>
      <p>Carnet d’entretien, produits, interventions, stocks et rappels centralisés.</p>
    </article>
    <article>
      <div class="feature-icon" aria-hidden="true">🏊</div>
      <h3>Équipements</h3>
      <p>Filtration, pompe à chaleur, électrolyseur, volet, éclairage et auxiliaires.</p>
    </article>
  </div>
</section>

<section class="section section-dashboard">
  <div class="dashboard-showcase">
    <div class="dashboard-showcase-copy">
      <span class="section-label">POOL PILOT DASHBOARD</span>
      <h2>La carte Pool Pilot reste au centre de l’expérience</h2>
      <p>
        Le site présente le projet, mais le pilotage reste dans Home Assistant.
        Vous retrouvez une vue unique pour suivre l’eau, les cycles, la météo,
        les équipements et les recommandations.
      </p>
      <ul>
        <li>Carte Lovelace installée via HACS</li>
        <li>Interface adaptée au mobile et au bureau</li>
        <li>Modes simple et expert</li>
        <li>Commandes regroupées dans une seule carte</li>
      </ul>
    </div>

    <div class="dashboard-showcase-image">
      <div class="showcase-browser-bar">
        <span></span><span></span><span></span>
        <strong>Home Assistant · Piscine</strong>
      </div>
      <div
        class="dashboard-showcase-crop"
        role="img"
        aria-label="Capture de Pool Pilot Dashboard"
        style="background-image:url('{{ url('theme://images/pool-pilot-dashboard.png') }}')">
      </div>
    </div>
  </div>
</section>

<section class="section home-project-showcase">
  <header class="section-heading">
    <span>POOL PILOT EN IMAGES</span>
    <h2>Découvrez concrètement l’interface et ses principaux outils</h2>
    <p>
      Pool Pilot ne se limite pas à une page de mesures. La carte regroupe le suivi,
      les réglages, l’entretien, les alertes et les équipements dans Home Assistant.
    </p>
  </header>

  <div class="home-showcase-main">
    <div class="home-showcase-copy">
      <span class="section-label">VUE PRINCIPALE</span>
      <h3>Une lecture immédiate de votre piscine</h3>
      <p>
        La vue principale affiche les paramètres essentiels, les recommandations,
        la filtration et les équipements sans quitter Home Assistant.
      </p>
      <ul>
        <li>Mesures principales regroupées</li>
        <li>Alertes et recommandations visibles</li>
        <li>Accès direct aux commandes</li>
        <li>Interface adaptée au mobile</li>
      </ul>
    </div>

    <figure class="home-large-shot">
      <a href="{{ url('theme://images/installation/11-dashboard-resultat.webp') }}" target="_blank">
        <img
          src="{{ url('theme://images/installation/11-dashboard-resultat.webp') }}"
          alt="Vue principale complète de Pool Pilot Dashboard"
          loading="lazy">
      </a>
      <figcaption>La vue principale de Pool Pilot Dashboard</figcaption>
    </figure>
  </div>
</section>

<section class="section home-gallery-section">
  <header class="section-heading">
    <span>UNE CARTE COMPLÈTE</span>
    <h2>Des outils pour le suivi quotidien et les réglages avancés</h2>
  </header>

  {% set home_gallery = [
    ['10-dashboard-analyse.webp', 'Analyse', 'Consultez les mesures, tendances et recommandations.'],
    ['16-mode-expert.webp', 'Mode Expert', 'Accédez aux informations et paramètres avancés.'],
    ['12-carnet-entretien.webp', 'Carnet d’entretien', 'Conservez l’historique des interventions.'],
    ['17-balance-taylor-bilan.webp', 'Balance de Taylor', 'Visualisez l’équilibre global de l’eau.'],
    ['22-pool-house-produits.webp', 'Pool House', 'Suivez les produits et les stocks disponibles.'],
    ['23-alerte-recommandation.webp', 'Alertes', 'Identifiez rapidement les actions à effectuer.']
  ] %}

  <div class="home-feature-gallery">
    {% for shot in home_gallery %}
    <article>
      <a href="{{ url('theme://images/installation/' ~ shot[0]) }}" target="_blank">
        <div class="home-gallery-image">
          <img
            src="{{ url('theme://images/installation/' ~ shot[0]) }}"
            alt="{{ shot[1] }}"
            loading="lazy">
        </div>
      </a>
      <div class="home-gallery-copy">
        <h3>{{ shot[1] }}</h3>
        <p>{{ shot[2] }}</p>
      </div>
    </article>
    {% endfor %}
  </div>

  <div class="section-action">
    <a class="button" href="{{ base_url_absolute }}/fonctionnalites">
      Découvrir toutes les fonctionnalités
    </a>
  </div>
</section>

<section class="section home-responsive-section">
  <div class="home-responsive-grid">
    <div class="home-responsive-copy">
      <span class="section-label">MOBILE ET BUREAU</span>
      <h2>La même expérience sur tous vos appareils</h2>
      <p>
        Pool Pilot Dashboard s’intègre à vos vues Home Assistant et reste utilisable
        depuis un téléphone, une tablette ou un ordinateur.
      </p>
      <ul>
        <li>Navigation pensée pour les écrans tactiles</li>
        <li>Informations organisées sans multiplier les cartes</li>
        <li>Accès aux commandes essentielles en déplacement</li>
        <li>Mode Expert disponible lorsque vous en avez besoin</li>
      </ul>
    </div>

    <div class="home-device-presentation">
      <figure class="home-device desktop">
        <div class="device-topbar">
          <span></span><span></span><span></span>
        </div>
        <img
          src="{{ url('theme://images/installation/10-dashboard-analyse.webp') }}"
          alt="Pool Pilot sur ordinateur"
          loading="lazy">
      </figure>

      <figure class="home-device mobile">
        <img
          src="{{ url('theme://images/installation/16-mode-expert.webp') }}"
          alt="Pool Pilot sur mobile"
          loading="lazy">
      </figure>
    </div>
  </div>
</section>

<section class="section section-installation" id="installation">
  <header class="section-heading">
    <span>INSTALLATION</span>
    <h2>Installer Pool Pilot via HACS</h2>
    <p>Une installation en quatre étapes, directement depuis votre instance Home Assistant.</p>
  </header>

  <ol class="installation-steps">
    <li>
      <b>1</b>
      <div>
        <h3>Ajouter le dépôt</h3>
        <p>Ajoutez le dépôt de l’intégration Pool Pilot dans les dépôts personnalisés HACS.</p>
      </div>
    </li>
    <li>
      <b>2</b>
      <div>
        <h3>Installer l’intégration</h3>
        <p>Recherchez Pool Pilot dans HACS, installez-la puis redémarrez Home Assistant.</p>
      </div>
    </li>
    <li>
      <b>3</b>
      <div>
        <h3>Configurer les équipements</h3>
        <p>Sélectionnez vos capteurs, votre filtration et les équipements disponibles.</p>
      </div>
    </li>
    <li>
      <b>4</b>
      <div>
        <h3>Ajouter la carte Dashboard</h3>
        <p>Installez Pool Pilot Dashboard puis ajoutez la carte à votre vue Lovelace.</p>
      </div>
    </li>
  </ol>

  <div class="section-action">
    <a class="button" href="#documentation">Consulter la documentation</a>
  </div>
</section>

<section class="section section-compatibility" id="compatibilite">
  <header class="section-heading">
    <span>COMPATIBILITÉ</span>
    <h2>Conçu pour votre environnement Home Assistant</h2>
    <p>Pool Pilot s’appuie sur les entités que vous avez déjà intégrées à Home Assistant.</p>
  </header>

  <div class="compatibility-list">
    <span>Home Assistant</span>
    <span>HACS</span>
    <span>Poolex Aqualyser</span>
    <span>Capteurs pH</span>
    <span>ORP / Redox</span>
    <span>Chlore libre</span>
    <span>Filtration</span>
    <span>Pompe à chaleur</span>
    <span>Électrolyseur</span>
    <span>Volet</span>
    <span>Éclairage</span>
    <span>Équipements auxiliaires</span>
  </div>
</section>

<section class="section section-documentation" id="documentation">
  <div>
    <span class="section-label">DOCUMENTATION</span>
    <h2>Des guides simples pour installer et configurer Pool Pilot</h2>
    <p>
      La documentation détaillée sera développée dans les prochaines versions du site :
      installation, configuration, entités, dépannage, carte Dashboard et mises à jour.
    </p>
  </div>
  <div class="documentation-list">
    <span><b>01</b> Installation</span>
    <span><b>02</b> Configuration</span>
    <span><b>03</b> Dashboard</span>
    <span><b>04</b> Dépannage</span>
  </div>
</section>

<section class="section section-roadmap" id="roadmap">
  <header class="section-heading">
    <span>ROADMAP</span>
    <h2>Un projet en évolution continue</h2>
  </header>

  <div class="roadmap-grid">
    <article>
      <small>VERSION ACTUELLE</small>
      <h3>v1.2.3</h3>
      <p>Mode Maintenance, carnet d’entretien, produits, notifications et amélioration de la carte.</p>
    </article>
    <article>
      <small>EN COURS</small>
      <h3>Corrections et tests</h3>
      <p>Stabilisation des fonctions existantes et amélioration de la compatibilité.</p>
    </article>
    <article>
      <small>PLUS TARD</small>
      <h3>Fonctions avancées</h3>
      <p>Régulation avancée et nouvelles intégrations selon les besoins du projet.</p>
    </article>
  </div>
</section>

<section class="section section-faq" id="faq">
  <header class="section-heading">
    <span>FAQ</span>
    <h2>Questions fréquentes</h2>
  </header>

  <div class="faq-list">
    <details>
      <summary>Pool Pilot est-il une intégration native de Home Assistant ?</summary>
      <p>Non. Pool Pilot est une intégration personnalisée installée et mise à jour via HACS.</p>
    </details>
    <details>
      <summary>La carte Pool Pilot Dashboard est-elle obligatoire ?</summary>
      <p>L’intégration et la carte sont complémentaires. La carte permet de profiter de l’interface complète.</p>
    </details>
    <details>
      <summary>Les données restent-elles dans Home Assistant ?</summary>
      <p>Pool Pilot utilise les entités et services configurés dans votre environnement Home Assistant.</p>
    </details>
  </div>
</section>

<section class="final-cta">
  <div>
    <h2>Prêt à piloter votre piscine depuis Home Assistant ?</h2>
    <p>Installez Pool Pilot via HACS et centralisez votre bassin dans une seule interface.</p>
  </div>
  <a class="button button-light" href="#installation">Installer via HACS</a>
</section>
{% endblock %}
